{
  "$schema": "https://design-tokens.github.io/community-group/format/#schema",
  "minimoto": {
    "color": {
      "black": { "value": "#0A0A0A" },
      "white": { "value": "#FFFFFF" },
      "paper": { "value": "#F4F3EF" },
      "line": { "value": "#B9B9B4" },
      "blue": { "value": "#1C37FF" }
    },
    "typography": {
      "sans": { "value": "Instrument Sans" },
      "editorial": { "value": "Newsreader" }
    },
    "usage": {
      "background": { "value": "{minimoto.color.paper}" },
      "surface": { "value": "{minimoto.color.white}" },
      "text": { "value": "{minimoto.color.black}" },
      "accent": { "value": "{minimoto.color.blue}" },
      "line": { "value": "{minimoto.color.line}" }
    },
    "rules": {
      "accent": { "value": "Use blue as a punctual signal, never as the dominant field." },
      "composition": { "value": "Wide margins, clear grids, one strong hierarchy per screen." }
    }
  }
}
